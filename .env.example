# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/tuition_marketplace?schema=public"

# JWT Configuration
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Frontend Configuration (comma-separated for multiple origins)
# Local:
FRONTEND_URL="http://localhost:3001"
# Production (Render) — exact production URL (preview URLs auto-allowed):
FRONTEND_URL="https://tuition-case-frontend-t7jb.vercel.app"

# File Upload Configuration
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=10485760

# Logging Configuration (optional)
LOG_LEVEL="debug"
